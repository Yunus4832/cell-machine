# 用 P 和 @ 实现最小调用与返回
#
# memory[80] 保存返回地址
# memory[81] 保存被调用程序入口20

>81
=20             # 被调用程序入口
<01

P               # memory[80] ← 当前PP，也就是04
+02             # 修正为 @01 后的继续地址06
@01             # PP ← memory[81]，调用地址20

# 地址06：返回后输出 RETURN
>10             # 使用90作为字符数据单元
=52 .00         # R
=45 .00         # E
=54 .00         # T
=55 .00         # U
=52 .00         # R
=4E .00         # N
=0A .00
:*

# 地址16—1F：填充到被调用程序入口20
+00
+00
+00
+00
+00
+00
+00
+00
+00
+00

# 地址20：被调用程序输出 CALL
>10             # DP: 80 → 90
=43 .00         # C
=41 .00         # A
=4C .00         # L
=4C .00         # L
=0A .00
<10             # DP: 90 → 80
@               # PP ← memory[80]，返回地址06
