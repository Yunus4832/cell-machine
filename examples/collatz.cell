# Collatz 类混沌轨道
# memory[80] = 当前值 x
# memory[81] = 商 q

>80
=1B             # 从十进制27开始

# 地址 02：输出当前值
.01

# 每消耗 x 的两个单位，q 加一
-01
(0B             # 减一次后为0：原数为奇数
-01
>01 +01 <01
(15             # 减两次后为0：原数为偶数
;03

# 地址 0B：奇数分支，3x+1 = 6q+4
>01
[
    -01
    <01 +06 >01
]
<01 +04
;02

# 地址 15：偶数分支，x = q
>01
[
    -01
    <01 +01 >01
]
<01
;02

