# 动态程序生成（A=8，W=12）
#
# 在 memory[80] 中构造机器字 A10：
#   opcode A = ';'
#   operand 10 = 绝对目标地址
# 随后用 D01 保存入口80，用 @01 间接执行 ;10

>80
=00
+* +* +* +* +* +* +* +* +* +* +1A
# 10*0FF + 01A = A10

D01              # memory[81] ← DP，也就是080
@01              # PP ← low8(memory[81])，跳到80

# 地址 0F：填充
+00

# 地址 10：动态跳转的目标
=44 .00         # D
=59 .00         # Y
=4E .00         # N
=41 .00         # A
=4D .00         # M
=49 .00         # I
=43 .00         # C
=0A .00

:*
